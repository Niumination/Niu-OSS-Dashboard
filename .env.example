# ------------------------------------------------------------------
# Niumination Dashboard — environment variables
# Salin file ini menjadi .env.local lalu isi sesuai kebutuhan.
# ------------------------------------------------------------------

# URL publik situs (untuk OpenGraph & sitemap).
# Produksi (Vercel + domain custom): https://niumination.web.id
# Preview Vercel: https://nama-app.vercel.app
SITE_URL=https://niumination.web.id

# Username GitHub yang ditampilkan (default: Niumination).
GITHUB_OWNER=Niumination

# Token GitHub PERSORONAN (opsional tapi sangat disarankan).
# Tanpa token: 60 request/jam per IP. Dengan token: 5.000 request/jam.
# Buat di: https://github.com/settings/tokens (tanpa scope pun cukup).
GITHUB_TOKEN=

# --- Monetisasi -----------------------------------------------------

# Client Key Midtrans SNAP (bisa diekspos ke client, ini memang public key).
# https://account.midtrans.com -> Merchant Details -> Setting -> SNAP
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=

# Server Key Midtrans (RAHASIA — hanya di server, jangan beri prefix NEXT_PUBLIC).
# Dipakai POST /api/pay/midtrans (Snap API) + verifikasi webhook.
MIDTRANS_SERVER_KEY=

# Stripe Secret Key (RAHASIA — hanya di server).
# Dipakai POST /api/pay/stripe (Checkout Session, IDR).
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=

# Stripe Hosted Payment Link (opsional; fallback bila STRIPE_SECRET_KEY tidak dipakai).
# https://dashboard.stripe.com/payment-links
NEXT_PUBLIC_STRIPE_PAYMENT_LINK=

# Kontak untuk form "Sewa Jasa / Konsultasi"
CONTACT_EMAIL=halo@niumination.dev
WHATSAPP_NUMBER=6281200000000
# Observabilitas (opsional) — lihat https://sentry.io untuk DSN
# SENTRY_DSN=

# --- Chat CS (Tencent RTC Chat — paket gratis 1.000 MAU) ------------
# Panduan lengkap: docs/TRTC-CHAT.md
# RAHASIA server-only (pelajaran #418: secret tidak pernah ber-prefix NEXT_PUBLIC_).
# console.trtc.io -> Chat -> App Info
TRTC_SDK_APP_ID=
TRTC_SDK_SECRET_KEY=
# Akun di console -> Chat -> Users (bot menjawab tamu; owner = Anda di /cs)
TRTC_ADMIN_ID=administrator
TRTC_BOT_ID=niu_bot
TRTC_OWNER_ID=niu_owner
# Token gerbang halaman /cs (buat acak panjang, mis. `openssl rand -hex 32`).
CS_ADMIN_TOKEN=
# Versi publik (aman diekspos — tanpa ini widget tidak tampil sama sekali).
NEXT_PUBLIC_TRTC_SDK_APP_ID=
NEXT_PUBLIC_TRTC_BOT_ID=niu_bot
NEXT_PUBLIC_TRTC_OWNER_ID=niu_owner

# AI BYOK opsional untuk jawaban bebas bot (endpoint OpenAI-compatible).
# Biarkan LLM_API_KEY kosong -> bot murni FAQ berbasis aturan (tetap hidup).
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Rate limit global lintas instance (opsional) — Upstash Redis REST:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
