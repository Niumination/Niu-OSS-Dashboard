# ------------------------------------------------------------------
# Niumination Dashboard — environment variables
# Salin file ini menjadi .env.local lalu isi sesuai kebutuhan.
# ------------------------------------------------------------------

# URL publik situs (untuk OpenGraph & sitemap).
# Vercel:  https://nama-app.vercel.app
# GH Pages: https://niumination.github.io
SITE_URL=https://niumination.github.io

# Username GitHub yang ditampilkan (default: Niumination).
GITHUB_OWNER=Niumination

# Token GitHub PERSORONAN (opsional tapi sangat disarankan).
# Tanpa token: 60 request/jam per IP. Dengan token: 5.000 request/jam.
# Buat di: https://github.com/settings/tokens (tanpa scope pun cukup).
GITHUB_TOKEN=

# --- Monetisasi -----------------------------------------------------

# Client Key Midtrans SNAP (bisa diekspos ke client, ini memang public key).
# https://account.midtrans.com -> Merchant Details -> Setting -> SNAP
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=

# Stripe Hosted Payment Link (satu link untuk semua donasi/paket).
# https://dashboard.stripe.com/payment-links
NEXT_PUBLIC_STRIPE_PAYMENT_LINK=

# Kontak untuk form "Sewa Jasa / Konsultasi"
CONTACT_EMAIL=halo@niumination.dev
WHATSAPP_NUMBER=6281200000000
