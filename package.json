    "gen:mock": "node scripts/gen-mock.mjs",
    "gen:mock:fresh": "node scripts/gen-mock.mjs --fresh",
    "export:static": "node scripts/export-static.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check:static": "node scripts/check-static.mjs",
    "test:e2e": "node tests/e2e/hydration.mjs",
    "gen:icons": "node scripts/gen-icons.mjs",
    "gen:api": "node scripts/gen-api.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "cmdk": "^1.1.1",
    "dompurify": "^3.4.15",
    "framer-motion": "^13.4.0",
    "fuse.js": "^7.5.0",
    "lucide-react": "^1.47.0",
    "marked": "^18.0.13",
    "next": "16.3.5",
    "qrcode": "^1.5.4",
    "react": "~19.2.8",
    "react-dom": "~19.2.8",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.18",
    "@types/three": "^0.186.0",
    "autoprefixer": "^10.6.1",
    "playwright": "^1.63.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.17",
    "typescript": "7.0.2",
    "vitest": "^5.0.1"
  }
