{
  "name": "niu-oss-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "Dasbor OSS & portofolio untuk github.com/niumination — Next.js App Router (Turbopack), R3F hero, command palette, aggregator GitHub, API publik v1, payment modal.",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:webpack": "next build --webpack",
